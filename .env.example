# Never commit a real .env file. Put your private Gnani key here locally only.
APP_NAME=BhashaBridge
APP_ENV=development
APP_VERSION=0.3.1
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_MB=20
MAX_OVERRIDE_CHARS=12000
DATA_DIR=./data
DEFAULT_LANGUAGE=hi-en

# ASR & Safety Verification Policy
ASR_CONFIDENCE_THRESHOLD=0.75
POLICY_VERSION=bb-verification-0.3.1

# Acoustic Health Gate Thresholds
AUDIO_MIN_DURATION=0.7
AUDIO_MAX_DURATION=120.0
AUDIO_NEAR_SILENT_RMS=0.003
AUDIO_CLIPPING_FRACTION=0.005
AUDIO_SILENCE_RATIO=0.75
AUDIO_MIN_SAMPLE_RATE=8000
AUDIO_MAX_SAMPLE_RATE=96000
AUDIO_TARGET_SAMPLE_RATE=16000

# Gnani Prisma v3 REST API (Speech-to-Text)
GNANI_API_KEY=vach_1ytE2CY5X2EgYLbA4Y8HbhdOC1SBFilDOKC8FmvxghNcMe0QaPkEtBgCaWRPbi2kNRCe8oZTQ00zzb5ePTC8xdeco6Jg4xVf_2166150e64dbac07cc7c04e37bad660e
GNANI_PRISMA_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_PRISMA_FORMAT=codemix
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_AUTH_SCHEME=
GNANI_HTTP_TIMEOUT=90

# Gnani Timbre v3 SSE API (Text-to-Speech)
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shubham
GNANI_TTS_CONTAINER=mp3
GNANI_TTS_SAMPLE_RATE=44100
GNANI_TTS_BITRATE=192k
GNANI_TTS_SAMPLE_WIDTH=2
GNANI_TTS_NUM_CHANNELS=1
GNANI_TTS_TIMEOUT=120

# Gnani Evon Sovereign Indic Reasoning LLM
GNANI_EVON_URL=https://api.vachana.ai/v1/chat/completions
GNANI_EVON_MODEL=evon-v1
GNANI_EVON_TEMPERATURE=0.2
GNANI_EVON_MAX_TOKENS=250
GNANI_EVON_TIMEOUT=45

# Optional local reasoning provider (Ollama fallback)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=60
